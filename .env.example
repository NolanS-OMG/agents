DEBUG=true
REDIS_URL=redis://redis:6379/0
TENANT_ID=santa_lena
ESTILO=chat

# PostgreSQL (port 5432 default; adjust if needed)
DATABASE_URL=postgres://agente:dev_password_123@localhost:5432/agente_ia

# Credential encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CREDENTIAL_ENCRYPTION_KEY=

# STT (Groq Whisper — optional, falls back to local Whisper if voice_enabled)
GROQ_API_KEY=

# WhatsApp Cloud API (Meta) — legacy single-tenant, use DB credentials for multi-tenant
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=agente_ia_verify_2026

# LLM Provider
LLM_PROVIDER=openrouter
LLM_API_KEY=your-api-key-here
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
