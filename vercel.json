{
  "builds": [
    {
      "src": "src/app/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/app/main.py"
    }
  ],
  "functions": {
    "src/app/main.py": {
      "maxDuration": 60
    }
  }
}
